+function isNonFatalFsync(error) {
+  return (
+    error?.code === "EPERM" ||
+    error?.code === "EISDIR" ||
+    error?.code === "EINVAL"
+  );
+}
+
+function fsyncHandle(handle) {
   try {
     fs.fsyncSync(handle);
+  } catch (error) {
+    if (!isNonFatalFsync(error)) throw error;
+  }
+}
+
+function fsyncDirectory(directory) {
+  let handle;
+  try {
+    handle = fs.openSync(directory, "r");
+    fsyncHandle(handle);
+  } catch (error) {
+    if (!isNonFatalFsync(error)) throw error;
   } finally {
-    fs.closeSync(handle);
+    if (handle !== undefined) fs.closeSync(handle);
